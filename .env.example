# ── Server ────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────
# Leave empty in development to use the persistent in-memory MongoDB fallback.
# Required in production. With docker compose it defaults to the bundled mongo service.
MONGODB_URI=

# ── Authentication ────────────────────────────────────────
# Required in every environment: at least 32 random bytes. The server refuses to
# start with this placeholder, a short value or anything that looks like one.
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_secret

# First admin account. Nothing is created unless both are set, and the password
# must be 12+ characters mixing at least three of: lowercase, uppercase, digits,
# symbols. Outside development/test it also needs ALLOW_BOOTSTRAP_ADMIN=true.
# Remove all three once the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_BOOTSTRAP_ADMIN=

# ── Google OAuth (optional — leave unset to hide Google buttons) ───────────
# Create a project at https://console.cloud.google.com/, enable "Google Identity"
# and add your domain + http://localhost:5173 as Authorised JavaScript origins.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production this MUST be set (the app will refuse to start).
#
# Dev extension ID is stable because the manifest has a fixed `key` field.
# For production, replace the dev extension ID with the Chrome Web Store ID
# after publishing.
# The server's CORS middleware splits this env var by comma.
CORS_ORIGINS=http://localhost:5173,chrome-extension://cgahnajflkjbbbpnmennbfpojdpahfdg

# ── Email (SMTP) ────────────────────────────────────────────
# SMTP_USER + SMTP_PASS must be set for email to work
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Suhayl" <suhayl@suhayl.online>

# Use true for port 465 (implicit TLS); 587 uses STARTTLS and needs false
SMTP_SECURE=false

# ── App URL ────────────────────────────────────────────────
# Public address of the web app. Every emailed link uses it: password resets,
# team invites and family links. Required in production.
APP_URL=https://suhayl.online

# ── Uploaded files (family documents) ──────────────────────
# local: files go to UPLOAD_DIR on this server, which must be a persistent volume.
# s3:    any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=auto
# Needed for R2/B2/MinIO, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=documents/
# true for MinIO and some self-hosted stores
S3_FORCE_PATH_STYLE=false

# ── Limits and links ───────────────────────────────────────
# Rate-limit counters are kept in MongoDB in production so they hold across
# restarts and several instances. Set to "memory" to keep them in the process.
RATE_LIMIT_STORE=
# Days a family link stays valid before the agency has to extend it
PORTAL_LINK_DAYS=180
# Set when running behind a proxy outside production (always on in production)
TRUST_PROXY=

# ── Sentry (optional — leave unset to disable error tracking) ─────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
LOG_LEVEL=info
