# ── Server ────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────
# Leave empty to use the persistent in-memory MongoDB fallback
MONGODB_URI=

# ── Authentication ────────────────────────────────────────
# Required. Use a long, random string (minimum 32 characters).
#   Linux/macOS:  openssl rand -hex 32
#   Windows:      Use an online generator or a UUID library
JWT_SECRET=change_me_to_a_random_secret

# ── Google OAuth (optional — leave unset to hide Google buttons) ───────────
# Create a project at https://console.cloud.google.com/, enable "Google Identity"
# and add your domain + http://localhost:5173 as Authorised JavaScript origins.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production this MUST be set (the app will refuse to start).
#
# Dev extension ID is stable because the manifest has a fixed `key` field.
# For production, replace the dev extension ID with the Chrome Web Store ID
# after publishing.
# The server's CORS middleware splits this env var by comma.
CORS_ORIGINS=http://localhost:5173,chrome-extension://cgahnajflkjbbbpnmennbfpojdpahfdg

# ── Email (SMTP) ────────────────────────────────────────────
# SMTP_USER + SMTP_PASS must be set for email to work
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Suhayl" <suhayl@suhayl.online>

# ── App URL (for reset-password link) ──────────────────────
APP_URL=https://suhayl.online

# ── Sentry (optional — leave unset to disable error tracking) ─────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
LOG_LEVEL=info
